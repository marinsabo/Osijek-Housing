Table users{
  id integer [primary key]
  first_name varchar(30) [not null]
  last_name varchar (50) [not null]
  email varchar (254) [not null, unique]
  is_moderator bool [not null, default: false]
  created_at timestamptz [not null, default: `now()`]
}


Table student {
  user_id integer [primary key]
  faculty_id integer [not null]
}

Table landlord {
  user_id integer [primary key]
  phone_number varchar(20) [not null]
  verified_at timestamptz
  verified_by integer
}

Table flat{
  id integer [primary key]
  landlord_id integer [not null]
  area_m2 numeric(6,2) [not null]
  number_of_rooms integer [not null]
  street varchar (50) [not null]
  house_number varchar(10) [not null]
  floor integer
  unit varchar (10)
  parking_type varchar (20)
  neighbourhood_id integer [not null]
  location geography(Point, 4326) [not null]
  archived_at timestamptz

  checks {
    `area_m2 > 0` [name: 'chk_area']
    `number_of_rooms > 0` [name: 'chk_number_of_rooms']
  }

  indexes {
    location [type: gist]
    landlord_id
    neighbourhood_id
  }
}

Table neighbourhood{
  id integer [primary key]
  name varchar (50) [not null, unique]
}

Table listing{
  id integer [primary key]
  flat_id integer [not null]
  price numeric(8,2) [not null]
  published_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  taken_at timestamptz
  archived_at timestamptz
  description varchar(1000) [not null]

  checks {
    `price > 0` [name: 'chk_price']
    `taken_at IS NULL OR archived_at IS NULL` [name: 'chk_taken_or_archived']
  }

  indexes {
    flat_id
  }
}

Table faculty{
    id integer [primary key]
    name varchar(20) [not null, unique]
    location geography(Point, 4326) [not null]
    email_domain varchar(50) [not null, unique]

    indexes {
      location [type: gist]
    }
}

Table review{
  id integer [primary key]
  rating integer [not null]
  description varchar(1000) [not null]
  student_id integer [not null]
  flat_id integer [not null]
  published_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  verified_at timestamptz
  verified_by integer
  hidden_at timestamptz
  hidden_by integer 

  checks {
    `rating BETWEEN 1 AND 5` [name: 'chk_rating']
  }

  indexes {
    (student_id, flat_id) [unique]
    flat_id
  }
}

Table report{
  id integer [primary key]
  review_id integer [not null]
  reporter_id integer [not null]
  description varchar(1000) [not null]
  created_at timestamptz [not null, default: `now()`]
  resolved_at timestamptz
  resolved_by integer

  indexes {
    (review_id, reporter_id) [unique]
  }
}

Table listing_photo{
  id integer [primary key]
  listing_id integer [not null]
  file_key varchar(255) [not null]
  position integer [not null]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (listing_id, position) [unique]
  }
}

Table login_code{
  id integer [primary key]
  email varchar(254) [not null]
  code_hash varchar(64) [not null]
  expires_at timestamptz [not null]
  attempts integer [not null, default: 0]
  used_at timestamptz

  indexes {
    email
  }
}

Ref: student.user_id - users.id
Ref: landlord.user_id - users.id
Ref: landlord.verified_by > users.id
Ref: flat.landlord_id > landlord.user_id
Ref: neighbourhood.id < flat.neighbourhood_id
Ref: flat.id < listing.flat_id
Ref: student.faculty_id > faculty.id
Ref: review.student_id > student.user_id
Ref: review.flat_id > flat.id [delete: restrict]
Ref: review.verified_by > users.id
Ref: review.id < report.review_id
Ref: users.id < report.reporter_id
Ref: report.resolved_by > users.id
Ref: listing_photo.listing_id > listing.id
Ref: review.hidden_by > users.id

